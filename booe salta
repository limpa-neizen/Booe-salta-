<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Booe Salta (Demo)</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&display=swap">
<style>
:root{--bg1:#1b0f33;--bg2:#05040a;--ink:#eef0f6;--lcd:#aab8d8;--lcdbg:#232b3e;--c1:#f6f8fb;--c2:#9aa3b2;--c3:#3f4655;--green1:#35c43f;--green2:#12801b;--bar:#171717;--gold:#ffd400;--red:#e0382e;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif;
background:radial-gradient(ellipse 18% 40% at 6% 45%,#5a2d8a55,transparent),radial-gradient(ellipse 18% 40% at 94% 45%,#2d4f8a55,transparent),radial-gradient(ellipse at 50% 15%,var(--bg1),var(--bg2) 75%)}
.top{max-width:1000px;margin:0 auto;padding:10px 14px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap}
.crumb{font-size:13px}.crumb u{text-underline-offset:2px}
.demo{background:var(--red);color:#fff;font:800 11px system-ui;letter-spacing:2px;padding:2px 9px;border-radius:999px;margin-left:8px;vertical-align:middle}
#jp{font:800 15px "Arial Black",Impact,sans-serif;letter-spacing:4px;color:var(--gold);border:2px solid #b8941a;border-radius:6px;padding:6px 26px;background:linear-gradient(#000,#241b00);box-shadow:0 0 10px #ffd40044,inset 0 0 6px #ffd40033}
#jp.flash{animation:fl .35s steps(2) 9;background:var(--gold);color:#000}
@keyframes fl{50%{background:#000;color:var(--gold)}}
@media (prefers-reduced-motion:reduce){#jp.flash{animation:none}}
.stage{position:relative;max-width:1000px;margin:0 auto;padding:6px 12px 30px}
.machine{width:100%;max-width:540px;margin:0 auto;position:relative;border-radius:26px 26px 80px 80px/26px 26px 40px 40px;padding:10px 14px 18px;background:linear-gradient(90deg,#222a36,var(--c1) 8%,var(--c2) 18%,#2a303c 24%,#2a303c 76%,var(--c2) 82%,var(--c1) 92%,#222a36);box-shadow:0 18px 60px #000c}
.plate{background:linear-gradient(#fff,#cdd3dc);border-radius:10px 10px 0 0;text-align:center;padding:8px 0 4px;font:400 clamp(30px,9vw,50px)/1.05 "Luckiest Guy","Arial Black",Impact,sans-serif;letter-spacing:2px;-webkit-text-stroke:3px #111;paint-order:stroke fill;text-shadow:2px 3px 0 #0006;min-height:56px}
.plate .sp{display:inline-block;width:.35em}
canvas{display:block;width:100%;height:auto;image-rendering:pixelated;border:3px solid #15181f;background:#3d9bff;cursor:pointer;touch-action:manipulation}
#msg{background:var(--bar);border:2px solid #2c2c2c;color:#fff;text-align:center;padding:10px 12px;margin:10px 4px 4px;min-height:50px;display:flex;align-items:center;justify-content:center;font-size:13.5px}
.rules{text-align:center;margin:0 0 6px}
.rules summary{display:inline-block;cursor:pointer;color:#fff;text-decoration:underline;font-size:12px}
.rules .rb{background:#fff;color:#111;border-radius:6px;padding:10px 14px;text-align:left;font-size:13px;margin-top:6px}
.rules ol{margin:4px 0 8px;padding-left:20px}.rules p{margin:6px 0}
.deck{position:relative;display:grid;grid-template-columns:1.25fr 1fr;gap:10px;align-items:start;padding:12px 8px 8px;border-radius:12px;background:repeating-linear-gradient(90deg,#1d222c 0 2px,#232a36 2px 4px)}
.chips{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.chips button:nth-child(5){grid-column:1/3}.chips button:nth-child(6){grid-column:3/5}
.chip,.x{font:600 13px system-ui;color:#2a2f3a;border:1px solid #6d7584;border-radius:6px;padding:7px 2px;cursor:pointer;background:linear-gradient(#fff,#aeb6c4);box-shadow:0 2px 0 #3a4150}
.right{display:grid;gap:7px}
.lcdrow{display:grid;grid-template-columns:1fr 38px;gap:6px}
.lcd{background:var(--lcdbg);color:var(--lcd);border:1px solid #000;border-radius:4px;padding:6px 8px;text-align:right;font:700 16px ui-monospace,Menlo,Consolas,monospace;width:100%}
.saldo{font-size:11px;color:#c9d3e8;background:var(--lcdbg);border-radius:4px;padding:3px 8px;display:flex;justify-content:space-between;font-family:ui-monospace,Menlo,monospace}
.bet{font:800 12.5px system-ui;color:#fff;text-transform:uppercase;border:1px solid #0b5a12;border-radius:6px;padding:10px 6px;cursor:pointer;background:linear-gradient(var(--green1),var(--green2));box-shadow:0 2px 0 #0b3d10}
.pad{position:absolute;right:-6px;bottom:-34px;width:112px;pointer-events:none}
.slot{margin:26px 0 0 4px;width:44%;height:42px;border-radius:6px;background:#0c0f14;border:2px solid #3a4150;position:relative}
.slot:after{content:"";position:absolute;left:14%;right:14%;top:45%;height:5px;border-radius:3px;background:#5fd0e6;box-shadow:0 0 8px #5fd0e6aa}
.strip{max-width:540px;margin:16px auto 0;display:flex;gap:6px;flex-wrap:wrap;align-items:center;justify-content:center;font-size:13px;color:#c6c0da}
.strip button{min-width:36px;height:34px;font:700 14px system-ui;border-radius:6px;border:1px solid #6d7584;background:linear-gradient(#fff,#c4cad5);cursor:pointer;touch-action:none;color:#222;padding:0 8px}
.strip .rech{background:linear-gradient(#ffe27a,#d9a516);font-size:12px}
.strip .sep{width:1px;height:22px;background:#6d7584;margin:0 4px}
.side{position:fixed;right:0;top:190px;display:none;background:#14161c;border:1px solid #2c2f38;border-right:0;border-radius:8px 0 0 8px;overflow:hidden}
.side button{display:block;width:40px;height:40px;background:none;border:0;border-bottom:1px solid #2c2f38;color:#d9dce6;font:700 16px system-ui;cursor:pointer}
@media(min-width:1000px){.side{display:block}}
button:disabled,input:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible,input:focus-visible,summary:focus-visible,canvas:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.foot{color:#a79fc0;font-size:12px;max-width:60ch;margin:14px auto 0;text-align:center}
@media(max-width:460px){.deck{grid-template-columns:1fr}.pad{display:none}}
</style>
</head>
<body>
<div class="top">
 <div class="crumb"><u>JUEGOS RÁPIDOS</u> / <u>LOTERÍA</u> / <span id="crumbT"></span><span class="demo">DEMO</span></div>
 <div id="jp">JACKPOT</div>
</div>
<div class="side" aria-label="Accesos">
 <button type="button" id="sInfo" aria-label="Ver reglas">ⓘ</button>
 <button type="button" id="sSnd" aria-label="Sonido activado" aria-pressed="true">🔊</button>
 <button type="button" id="sRech" aria-label="Recargar saldo demo">$</button>
</div>
<div class="stage">
 <div class="machine">
  <div class="plate" id="plate"></div>
  <canvas id="scene" width="480" height="260" tabindex="0" aria-label="Escena del juego. Flechas izquierda y derecha para moverse, flecha arriba para saltar."></canvas>
  <div id="msg" role="status" aria-live="polite"></div>
  <details class="rules" id="rulesD"><summary>Reglas</summary><div class="rb" id="rules"></div></details>
  <div class="deck">
   <div class="chips" id="chips"></div>
   <div class="right">
    <div class="saldo"><span>SALDO DEMO</span><span><span id="saldo">0</span> ARS</span></div>
    <div class="lcdrow"><input class="lcd" id="inp" type="number" min="70" max="207352.34" step="0.01" value="70" aria-label="Importe de la apuesta en ARS"><button class="x" id="x" aria-label="Borrar importe o cancelar apuesta">✕</button></div>
    <button class="bet" id="go">Hacer una apuesta</button>
   </div>
   <svg class="pad" viewBox="0 0 120 70" aria-hidden="true"><path d="M20 12h80q14 0 16 20t-14 26q-10 4-18-6H36q-8 10-18 6Q4 52 4 32t16-20z" fill="#f2f2f6" stroke="#9a9aa8" stroke-width="2"/><rect x="26" y="26" width="26" height="8" rx="2" fill="#555"/><rect x="35" y="17" width="8" height="26" rx="2" fill="#555"/><circle cx="84" cy="22" r="6" fill="#6a4bd6"/><circle cx="98" cy="32" r="6" fill="#6a4bd6"/><circle cx="84" cy="42" r="6" fill="#6a4bd6"/><circle cx="70" cy="32" r="6" fill="#6a4bd6"/></svg>
  </div>
  <div class="slot" aria-hidden="true"></div>
 </div>
 <div class="strip">
  <button id="bl" type="button" aria-label="Mover a la izquierda">◀</button>
  <button id="bu" type="button" aria-label="Saltar">▲</button>
  <button id="br" type="button" aria-label="Mover a la derecha">▶</button>
  <span class="sep"></span><span>Ir al cubo:</span><span id="goto" style="display:contents"></span>
  <span class="sep"></span>
  <button id="snd" type="button" aria-pressed="true" aria-label="Sonido activado">🔊</button>
  <button class="rech" id="rech" type="button">Recargar saldo (demo)</button>
 </div>
 <p class="foot">Modo Demo: puntos virtuales, recargables y sin dinero real. Cada cubo es aleatorio e independiente: elegir otro cubo no mejora ni empeora tus probabilidades.</p>
</div>

<script>
/* ===== Configuración ===== */
var TITLE='BOOE SALTA';             /* cambie aquí el nombre del juego */
var TITLE_COLORS=['#e52521','#ffd400','#1f9ae0','#43b047','#e52521'];
var MIN=70, MAX=207352.34, START=50000, RECHARGE=50000, CHIPS=[70,400,1000,3000,9000,40000];
/* Por ronda: 1 cubo ×0, 1 seta y 4 cubos con cuotas distintas (sin repetir) tomadas de [cuota, peso en %] */
var ODDS=[[1,40],[2,25],[3,15],[4,9],[5,5],[6,3],[7,1.5],[8,1],[9,.5]];
var JACKPOT_FROM=5;                  /* cuota mínima que dispara el jackpot */
var SPEED=120;
var CLOUDS=[{x:6,y:12,s:1,v:48},{x:210,y:52,s:1.3,v:8},{x:370,y:30,s:.9,v:22}]; /* rápida, lenta, semilenta */
/* ========================= */
var $=function(i){return document.getElementById(i)};
var fmt=function(n){return Number(n).toLocaleString('es-AR',{maximumFractionDigits:2})};
var r2=function(n){return Math.round(n*100)/100};
var clamp=function(v,a,b){return Math.max(a,Math.min(b,v))};
var TOT=ODDS.reduce(function(a,o){return a+o[1]},0);
var W=480,H=260,G=217,BY=82,BS=44,BX=[62,134,206,278,350,422],HS=3,HIT=48;
var cv=$('scene'),ctx=cv.getContext('2d');ctx.imageSmoothingEnabled=false;
var DEF='¡Seleccione o introduzca el importe de la apuesta!';

/* Título */
(function(){var p=$('plate'),k=0;p.setAttribute('aria-label',TITLE);$('crumbT').textContent=TITLE;
  TITLE.split('').forEach(function(ch){var s=document.createElement('span');
    if(ch===' '){s.className='sp'}else{s.textContent=ch;s.style.color=TITLE_COLORS[k++%TITLE_COLORS.length]}p.appendChild(s)})})();

/* Elige k cuotas distintas, con probabilidad según su peso */
function drawDistinct(k){var pool=ODDS.slice(),out=[];for(var j=0;j<k;j++){var tot=pool.reduce(function(a,o){return a+o[1]},0),r=Math.random()*tot,a=0,ix=pool.length-1;for(var i=0;i<pool.length;i++){a+=pool[i][1];if(r<a){ix=i;break}}out.push(pool[ix][0]);pool.splice(ix,1)}return out}

/* ===== Sonido (Web Audio) ===== */
var AC=null,muted=false;
function ac(){if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(AC&&AC.state==='suspended')AC.resume();return AC}
function tone(f,t0,d,type,vol){var a=ac();if(!a||muted)return;var o=a.createOscillator(),g=a.createGain(),t=a.currentTime+t0;
  o.type=type||'square';o.frequency.setValueAtTime(f,t);g.gain.setValueAtTime(vol||.07,t);g.gain.exponentialRampToValueAtTime(.001,t+d);
  o.connect(g);g.connect(a.destination);o.start(t);o.stop(t+d+.02)}
function sfx(n){
  if(n==='jump'){tone(300,0,.08);tone(520,.06,.1)}
  else if(n==='bump'){tone(120,0,.1,'triangle',.12)}
  else if(n==='mush'){[523,659,784,1047].forEach(function(f,i){tone(f,i*.09,.12)})}
  else if(n==='lose'){[330,262,196].forEach(function(f,i){tone(f,i*.14,.2,'triangle',.1)})}
  else if(n==='even'){tone(440,0,.12,'triangle',.08)}
  else if(n==='coin'){tone(988,0,.08);tone(1319,.08,.35)}
  else if(n==='jackpot'){
    var seq=[523,659,784,1047,1319,1568,2093];
    for(var k=0;k<3;k++)seq.forEach(function(f,i){tone(f,k*.5+i*.06,.1)});
    [523,659,784,1047].forEach(function(f){tone(f,1.55,.9,'triangle',.07)});
    for(var c=0;c<8;c++)tone(1319+(c%2)*330,1.6+c*.08,.12,'square',.05);
  }
}
['pointerdown','keydown'].forEach(function(e){window.addEventListener(e,function(){ac()},{passive:true})});
function toggleSnd(){muted=!muted;['snd','sSnd'].forEach(function(id){var b=$(id);b.textContent=muted?'🔇':'🔊';b.setAttribute('aria-pressed',String(!muted));b.setAttribute('aria-label',muted?'Sonido desactivado':'Sonido activado')})}
$('snd').onclick=toggleSnd;$('sSnd').onclick=toggleSnd;
$('sInfo').onclick=function(){var d=$('rulesD');d.open=!d.open;d.scrollIntoView({block:'center'})};

/* ===== Personaje (sprite original 12x14) ===== */
var MAP=["...hhhhh....","..hhhhhhhh..","..bbbssbs...",".bsbsssbsss.",".bsbbsssbsss","..bbsssssbb.","...ssssss...","..ttoootttt.",".ttttoootttt","ssttoooottss","ss.oooooo.ss","...oo..oo...","..bbb..bbb..",".bbbb..bbbb."];
var PAL={h:'#2f6fdb',b:'#5a3a22',s:'#f0b27a',t:'#f2c230',o:'#2b8f4e'};
var spr=document.createElement('canvas');spr.width=12;spr.height=14;
(function(){var c=spr.getContext('2d');MAP.forEach(function(r,y){for(var x=0;x<12;x++){var p=PAL[r[x]];if(p){c.fillStyle=p;c.fillRect(x,y,1,1)}}})})();

var S={pts:START,bet:0,phase:'idle',vals:null,mush:-1,used:[],revealAll:false,bump:-1,bumpT:0,target:null};
var hero={x:63,off:0,vy:0,dir:1,walking:false,jumping:false,checked:true};
var keys={l:false,r:false};

function msg(t){$('msg').textContent=t}
function ui(){
  var idle=S.phase==='idle',play=S.phase==='play';
  $('saldo').textContent=fmt(S.pts);
  $('inp').disabled=!idle;$('rech').disabled=!idle;$('sRech').disabled=!idle;
  document.querySelectorAll('.chip').forEach(function(b){b.disabled=!idle});
  $('x').disabled=!(idle||play);
  var g=$('go');
  if(idle){g.textContent=S.pts<MIN?'Recargar saldo':'Hacer una apuesta';g.disabled=false}
  else if(play){g.textContent='Saltar';g.disabled=false}
  else{g.textContent='Resultado…';g.disabled=true}
}
function recharge(){S.pts=r2(S.pts+RECHARGE);sfx('coin');msg('Saldo demo recargado: +'+fmt(RECHARGE)+' ARS.');ui()}

/* ===== Flujo de la ronda ===== */
function newRound(){
  var idx=[0,1,2,3,4,5];
  for(var i=5;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=idx[i];idx[i]=idx[j];idx[j]=t}
  S.mush=idx[0];var zero=idx[1];
  var dv=drawDistinct(4),c=0;S.vals=[];for(var k=0;k<6;k++)S.vals.push(k===zero||k===S.mush?null:dv[c++]);
  S.vals[zero]=0;S.vals[S.mush]=null;       /* un solo ×0 y una sola seta */
  S.used=[false,false,false,false,false,false];S.revealAll=false;S.phase='play';
  msg('Muévase con ← →, o toque la pantalla, y salte con ↑ para golpear un cubo.');ui();
}
function endRound(){S.phase='idle';S.revealAll=false;S.vals=null;S.used=[];msg(S.pts<MIN?'Saldo insuficiente. Recargue (demo) para seguir.':DEF);ui()}
function hitBlock(i){
  if(S.phase!=='play'){msg('Haga su apuesta para que el golpe cuente.');return}
  if(S.used[i]){msg('Ese cubo ya fue golpeado. Elija otro.');return}
  S.used[i]=true;
  if(i===S.mush){sfx('mush');msg('¡Seta! Recibe otro intento: elija otro cubo sin saber qué esconde.');return}
  var v=S.vals[i],pay=r2(S.bet*v),net=r2(pay-S.bet);
  S.pts=r2(S.pts+net);S.revealAll=true;S.phase='result';
  var t;
  if(v===0){t='Cuota ×0: pierde '+fmt(S.bet)+' ARS.';sfx('lose')}
  else if(v===1){t='Cuota ×1: recupera su apuesta.';sfx('even')}
  else if(v>=JACKPOT_FROM){t='¡JACKPOT! Cuota ×'+v+': recibe '+fmt(pay)+' ARS (ganancia '+fmt(net)+').';sfx('jackpot');flashJp()}
  else{t='¡Cuota ×'+v+'! Recibe '+fmt(pay)+' ARS (ganancia '+fmt(net)+').';sfx('coin')}
  msg(t);ui();setTimeout(endRound,3600);
}
function flashJp(){var j=$('jp');j.classList.remove('flash');void j.offsetWidth;j.classList.add('flash');setTimeout(function(){j.classList.remove('flash')},3300)}

$('go').onclick=function(){
  if(S.phase==='idle'){
    if(S.pts<MIN){recharge();return}
    var b=r2(parseFloat($('inp').value));
    if(!(b>=MIN)){msg('El importe mínimo de la apuesta es '+fmt(MIN)+' ARS.');return}
    if(b>MAX){msg('El importe máximo de la apuesta es '+fmt(MAX)+' ARS.');return}
    if(b>S.pts){msg('El importe supera su saldo. Puede recargar (demo).');return}
    S.bet=b;newRound();
  }else if(S.phase==='play')jump();
};
$('rech').onclick=recharge;$('sRech').onclick=function(){if(S.phase==='idle')recharge()};
$('x').onclick=function(){
  if(S.phase==='play'){S.phase='idle';S.vals=null;S.used=[];msg('Apuesta cancelada. '+DEF);ui()}
  else{$('inp').value='';msg(DEF)}
};
CHIPS.forEach(function(v){var b=document.createElement('button');b.className='chip';b.type='button';b.textContent=fmt(v);b.onclick=function(){$('inp').value=v};$('chips').appendChild(b)});

/* ===== Movimiento libre ===== */
function nearest(x){for(var i=0;i<6;i++)if(Math.abs(x-BX[i])<=BS/2+8)return i;return -1}
function jump(){if(hero.jumping)return;hero.jumping=true;hero.vy=-330;hero.checked=false;sfx('jump')}
function goTo(x){S.target=clamp(x,20,W-20)}
cv.addEventListener('click',function(e){
  var r=cv.getBoundingClientRect(),x=(e.clientX-r.left)*W/r.width,y=(e.clientY-r.top)*H/r.height;
  var i=-1;for(var k=0;k<6;k++)if(Math.abs(x-BX[k])<=BS/2+6&&y>=BY-10&&y<=BY+BS+10)i=k;
  if(i>=0){if(Math.abs(hero.x-BX[i])<=6&&!hero.jumping){jump()}else goTo(BX[i])}
  else goTo(x);
  cv.focus({preventScroll:true});
});
for(var q=0;q<6;q++)(function(i){var b=document.createElement('button');b.type='button';b.textContent=i+1;b.setAttribute('aria-label','Ir al cubo '+(i+1));b.onclick=function(){goTo(BX[i])};$('goto').appendChild(b)})(q);
window.addEventListener('keydown',function(e){
  if(e.target&&e.target.tagName==='INPUT')return;
  if(e.key==='ArrowLeft'){keys.l=true;e.preventDefault()}
  else if(e.key==='ArrowRight'){keys.r=true;e.preventDefault()}
  else if(e.key==='ArrowUp'){jump();e.preventDefault()}
});
window.addEventListener('keyup',function(e){if(e.key==='ArrowLeft')keys.l=false;if(e.key==='ArrowRight')keys.r=false});
function hold(id,k){var b=$(id);b.addEventListener('pointerdown',function(e){e.preventDefault();keys[k]=true});['pointerup','pointerleave','pointercancel'].forEach(function(ev){b.addEventListener(ev,function(){keys[k]=false})})}
hold('bl','l');hold('br','r');$('bu').onclick=jump;

/* ===== Reglas ===== */
(function(){
  function selProb(){var P=ODDS.map(function(){return 0});(function rec(ch,rem,p){if(ch.length===4){ch.forEach(function(i){P[i]+=p});return}for(var i=0;i<ODDS.length;i++){if(ch.indexOf(i)>=0)continue;var w=ODDS[i][1];rec(ch.concat(i),rem-w,p*w/rem)}})([],TOT,1);return P}
  var P=selProb(),pv=P.map(function(x){return .8*x/4});
  var E=ODDS.reduce(function(a,o,i){return a+o[0]*pv[i]},0);
  var pw=pv.slice(1).reduce(function(a,b){return a+b},0);
  var pZero=.2;
  var li=ODDS.map(function(o,i){return '×'+o[0]+': '+fmt(pv[i]*100)+'%'}).join(' · ');
  $('rules').innerHTML='<p><b>Haga su apuesta.</b> Debe determinar el importe inicial de la apuesta antes de que empiece el juego.</p>'
  +'<ol><li>La apuesta máxima es de '+fmt(MAX)+' ARS y la apuesta mínima es de '+fmt(MIN)+' ARS.</li>'
  +'<li>El personaje debe saltar y golpear uno de los bloques.</li>'
  +'<li>Controle los movimientos del personaje usando las flechas de dirección en su teclado o los botones en pantalla: con la tecla «Derecha» corre hacia la derecha; con la tecla «Izquierda», a la izquierda; con la tecla «Arriba» salta. También puede tocar la pantalla para que camine hasta ese punto.</li>'
  +'<li>Cuando el personaje golpee uno de los bloques, aparecerán cuotas de entre ×0 y ×9. Su apuesta se multiplicará por la cuota indicada. Las cuotas no se repiten dentro de la misma jugada.</li>'
  +'<li>Si aparece una seta, recibe otro intento.</li></ol>'
  +'<p>¿Recuerda cuando jugaba en la consola día y noche? ¡Es el momento de volver a jugar! ¡Apueste y disfrute sus ganancias!</p>'
  +'<p>Una vez iniciada la partida, deberá completarla en un plazo de 7 días, y si está utilizando una cuenta de bono, 5 días. Al final de este periodo, la partida finalizará automáticamente y perderá su apuesta. <i>(En esta Demo no se aplica el plazo.)</i></p>'
  +'<p><b>Datos de esta Demo</b><br>En cada ronda hay un solo cubo ×0, una sola seta y cuatro cubos con cuotas distintas entre ×1 y ×9, repartidos al azar. Probabilidad de cada resultado al golpear un cubo: ×0: '+fmt(pZero*100)+'%; '+li+'. Probabilidad de ganar (×2 o más): '+fmt(pw*100)+'%. Retorno esperado: '+fmt(E*100)+'%.'+(E>1?' Al no repetirse las cuotas, esta Demo favorece al jugador; un juego real con dinero no sería así.':'')+'</p>';
})();

/* ===== Animación ===== */
function update(dt){
  CLOUDS.forEach(function(c){c.x+=c.v*dt;if(c.x>W+20)c.x=-60*c.s});
  var dir=(keys.r?1:0)-(keys.l?1:0);
  if(dir)S.target=null;
  else if(S.target!==null){var dx=S.target-hero.x;if(Math.abs(dx)<=2){hero.x=S.target;S.target=null}else dir=Math.sign(dx)}
  hero.walking=dir!==0&&!hero.jumping;
  if(dir){hero.x=clamp(hero.x+dir*SPEED*dt,20,W-20);hero.dir=dir}
  if(hero.jumping){
    hero.vy+=900*dt;hero.off+=hero.vy*dt;
    if(!hero.checked&&hero.off<=-HIT&&hero.vy<0){
      hero.checked=true;var i=nearest(hero.x);
      if(i>=0){hero.vy=Math.max(hero.vy,0);hero.off=-HIT;S.bump=i;S.bumpT=.25;sfx('bump');hitBlock(i)}
    }
    if(hero.off>=0){hero.off=0;hero.jumping=false;hero.vy=0}
  }
  if(S.bumpT>0)S.bumpT-=dt;
}
function cloud(c){var x=c.x,y=c.y,s=c.s;ctx.fillStyle='#fff';
  [[0,0,10],[14,-6,13],[30,0,10]].forEach(function(p){ctx.beginPath();ctx.arc(x+p[0]*s,y+p[1]*s,p[2]*s,0,7);ctx.fill()});
  ctx.fillRect(x,y,30*s,10*s)}
function hill(x,w,h){ctx.fillStyle='#2f9d3a';ctx.beginPath();ctx.ellipse(x+w/2,G,w/2,h,0,Math.PI,2*Math.PI);ctx.fill();ctx.strokeStyle='#0f4a17';ctx.lineWidth=2;ctx.stroke()}
function valColor(v){return v===0?'#8c2b24':v===1?'#6b6890':v>=JACKPOT_FROM?'#b07a00':'#1b8a5a'}
function scene(t){
  ctx.fillStyle='#3d9bff';ctx.fillRect(0,0,W,H);
  CLOUDS.forEach(cloud);
  hill(-10,60,24);hill(75,72,36);hill(287,58,30);
  /* tubo */
  ctx.fillStyle='#2eaa3a';ctx.fillRect(428,172,46,G-172);ctx.fillRect(423,155,57,18);
  ctx.fillStyle='#8ae894';ctx.fillRect(433,175,6,G-175);ctx.fillRect(427,157,6,14);
  ctx.strokeStyle='#0f4a17';ctx.lineWidth=2;ctx.strokeRect(428,172,46,G-172);ctx.strokeRect(423,155,57,18);
  /* seta decorativa (la del juego está oculta en un cubo) */
  ctx.fillStyle='#f5e3c3';ctx.fillRect(371,G-13,14,13);
  ctx.fillStyle='#e0682e';ctx.beginPath();ctx.ellipse(378,G-13,15,14,0,Math.PI,2*Math.PI);ctx.fill();
  ctx.fillStyle='#fff';ctx.fillRect(366,G-24,6,6);ctx.fillRect(380,G-27,6,6);
  /* suelo */
  ctx.fillStyle='#c8532a';ctx.fillRect(0,G,W,H-G);
  ctx.strokeStyle='#5a1c0a';ctx.lineWidth=2;
  for(var r=0;r<3;r++){var y=G+r*14.3;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
    for(var x=(r%2)*14;x<W;x+=28){ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y+14.3);ctx.stroke()}}
  ctx.fillStyle='#f0a060';ctx.fillRect(0,G,W,3);
  /* cubos */
  var under=S.phase==='play'?nearest(hero.x):-1,h=BS/2;
  for(var i=0;i<6;i++){
    var bx=BX[i]-h,by=BY-(i===S.bump&&S.bumpT>0?8:0);
    var showMush=(S.revealAll||S.used[i])&&i===S.mush&&S.phase!=='idle';
    var showVal=S.revealAll&&S.vals&&i!==S.mush;
    ctx.textAlign='center';ctx.textBaseline='middle';
    if(showMush){
      ctx.fillStyle='#b2459c';ctx.fillRect(bx,by,BS,BS);ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.strokeRect(bx+1,by+1,BS-2,BS-2);
      ctx.font='26px sans-serif';ctx.fillText('🍄',BX[i],by+h+1);
    }else if(showVal){
      var v=S.vals[i];ctx.fillStyle=valColor(v);ctx.fillRect(bx,by,BS,BS);
      ctx.strokeStyle=S.used[i]?'#fff':'#000';ctx.lineWidth=S.used[i]?4:2;ctx.strokeRect(bx+1,by+1,BS-2,BS-2);
      ctx.fillStyle='#fff';ctx.font='bold 20px monospace';ctx.fillText('×'+v,BX[i],by+h+1);
    }else{
      ctx.fillStyle=S.used[i]?'#7a3a28':'#a2402a';ctx.fillRect(bx,by,BS,BS);
      ctx.strokeStyle='#000';ctx.lineWidth=2;ctx.strokeRect(bx+1,by+1,BS-2,BS-2);
      ctx.fillStyle='#3a1208';[[5,5],[BS-10,5],[5,BS-10],[BS-10,BS-10]].forEach(function(p){ctx.fillRect(bx+p[0],by+p[1],5,5)});
      if(i===under&&!S.used[i]){ctx.strokeStyle='#ffd400';ctx.lineWidth=3;ctx.strokeRect(bx-3,by-3,BS+6,BS+6)}
    }
  }
  var bob=hero.walking?-Math.abs(Math.sin(t*14))*2:0;
  ctx.save();ctx.translate(hero.x,G-14*HS+hero.off+bob);ctx.scale(hero.dir,1);ctx.drawImage(spr,-6*HS,0,12*HS,14*HS);ctx.restore();
  ctx.fillStyle='#e0382e';ctx.fillRect(0,0,50,16);ctx.fillStyle='#fff';ctx.font='bold 11px sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('DEMO',25,8.5);
}
var last=0;
function frame(ts){var dt=Math.min(.05,(ts-last)/1000||0);last=ts;update(dt);scene(ts/1000);requestAnimationFrame(frame)}
msg(DEF);ui();requestAnimationFrame(frame);
</script>
